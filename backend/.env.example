# ==========================================
# BACKEND ENVIRONMENT VARIABLES (TEMPLATE)
# ==========================================
# Copy this file to `.env` in the backend folder.
# Replace placeholders with your real values.
# NEVER commit the actual .env to GitHub!

# Port the Express server listens on
PORT=5000

# Frontend URL (for CORS — change to your deployed domain in production)
FRONTEND_URL=http://localhost:5173

NODE_ENV=development

# ── Aiven MySQL Connection ──────────────────────────
# Find these in your Aiven console → Services → your MySQL service → Overview
DB_HOST=your-mysql-service-name.aivencloud.com
DB_PORT=your-mysql-port-number
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb
DB_SSL_REJECT_UNAUTHORIZED=false

# ── Admin Authentication ────────────────────────────
# The email address used to log in to the admin dashboard
ADMIN_EMAIL=your-admin-email@example.com

# bcrypt hash of your admin password.
# To generate one, run this command in the backend folder:
#   node -e "const b=require('bcryptjs');b.hash('YourPassword123',10).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$10$exampleHashReplaceThisWithARealOne

# Random secret used to sign JWT tokens. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-string-at-least-32-chars
